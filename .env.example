DESKTOP_MCP_SERVER_NAME=desktop-mcp
DESKTOP_MCP_SERVER_VERSION=0.2.0

# Local Agent
DESKTOP_MCP_AGENT_URL=http://127.0.0.1:8788
DESKTOP_MCP_AGENT_TOKEN=change-me
DESKTOP_MCP_WORKSPACE=C:\\AI-Workspace
DESKTOP_MCP_ALLOW_LOCAL_BROWSER=false
DESKTOP_MCP_AGENT_PORT=8788

# Gateway
DESKTOP_MCP_GATEWAY_URL=http://127.0.0.1:8790
DESKTOP_MCP_GATEWAY_WS_URL=ws://127.0.0.1:8790/agent
DESKTOP_MCP_GATEWAY_INTERNAL_TOKEN=change-me-admin
DESKTOP_MCP_GATEWAY_PORT=8790
DESKTOP_MCP_BIND_ADDRESS=127.0.0.1
DESKTOP_MCP_ADMIN_TOKEN=change-me-admin

# Production database / cache
# DESKTOP_MCP_DATABASE_URL=postgresql://user:password@host:5432/desktop_mcp
# REDIS_URL=redis://:password@host:6379

# Auth
DESKTOP_MCP_JWT_SECRET=replace-with-a-long-random-secret
# Production OAuth owner login for the authorization approval page
# DESKTOP_MCP_OAUTH_USER=admin
# DESKTOP_MCP_OAUTH_PASSWORD=replace-with-a-long-random-password

# Dashboard
# DASHBOARD_AUTH_USER=admin
# DASHBOARD_AUTH_PASSWORD=replace-with-a-long-random-password

# Policy
DESKTOP_MCP_CONFIRM_MEDIUM=false
DESKTOP_MCP_ALLOW_GIT_WRITE=false
DESKTOP_MCP_ALLOW_EXTERNAL_WRITES=false
DESKTOP_MCP_MAX_OUTPUT=1000000
DESKTOP_MCP_MAX_ENTRIES=1000

# Optional OIDC / SSO
# DESKTOP_MCP_OIDC_ISSUER=https://id.example.com/
# DESKTOP_MCP_OIDC_AUDIENCE=desktop-mcp
# DESKTOP_MCP_OIDC_JWKS_URL=https://id.example.com/.well-known/jwks.json

# Optional TLS / reverse proxy
# DESKTOP_MCP_TLS_CERT=/absolute/path/fullchain.pem
# DESKTOP_MCP_TLS_KEY=/absolute/path/privkey.pem
# DESKTOP_MCP_TRUST_PROXY_TLS=true

# Optional GitHub
# GITHUB_TOKEN=

# Optional Gmail / Outlook OAuth access tokens
# GMAIL_ACCESS_TOKEN=
# OUTLOOK_ACCESS_TOKEN=

# Optional remote device pairing
# DESKTOP_MCP_DEVICE_ID=
# DESKTOP_MCP_DEVICE_TOKEN=
# DESKTOP_MCP_PAIR_CODE=
