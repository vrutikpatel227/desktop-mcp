{
  "name": "desktop-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Universal Desktop MCP Server and local execution agent",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "tsx apps/mcp-server/src/index.ts",
    "dev:agent": "tsx apps/desktop-agent/src/index.ts",
    "dev:cli": "tsx apps/cli/src/index.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --test",
    "doctor": "tsx apps/cli/src/index.ts doctor"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
