{
  "name": "desktop-mcp",
  "version": "0.3.0",
  "files": [
    "bin",
    "scripts/remote-connect.ps1",
    "scripts/remote-connect.cmd",
    "dist/apps/desktop-agent",
    "dist/packages"
  ],
  "license": "MIT",
  "type": "module",
  "description": "Universal Desktop MCP Server and local execution agent",
  "bin": {
    "desktop-mcp": "./bin/desktop-mcp.cjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "tsx apps/mcp-server/src/index.ts",
    "dev:gateway": "tsx apps/gateway/src/index.ts",
    "dev:agent": "tsx apps/desktop-agent/src/index.ts",
    "dev:dashboard": "npm --prefix apps/dashboard run dev",
    "dev:cli": "tsx apps/cli/src/index.ts",
    "remote": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/remote-connect.ps1",
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "doctor": "tsx apps/cli/src/index.ts doctor"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@octokit/rest": "^22.0.1",
    "@types/express": "^5.0.6",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "next": "^16.3.8",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "redis": "^6.3.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
