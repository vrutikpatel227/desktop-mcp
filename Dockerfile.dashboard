FROM node:24-bookworm-slim AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

FROM deps AS build
COPY . .
RUN npm --prefix apps/dashboard run build

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
COPY --from=build /app ./
ENV NODE_ENV=production
EXPOSE 3000
CMD ["npm", "--prefix", "apps/dashboard", "run", "start"]
